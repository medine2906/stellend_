# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stellar network
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# TR Mock Anchor (SEP-10 / SEP-6 / SEP-38)
NEXT_PUBLIC_ANCHOR_URL=https://tr-mock-anchor.fly.dev

# Blend v2 (Stellar Testnet) — from blend-capital/blend-utils' testnet.contracts.json
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_BLEND_POOL_ID=CAPBMXIQTICKWFPWFDJWMAKBXBPJZUKLNONQH3MLPLLBKQ643CYN5PRW
NEXT_PUBLIC_USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# XLM Stellar Asset Contract id, for use as collateral in the borrow flow's
# "asset" field (not a separate env var — passed directly in the UI/API call).
# NEXT_PUBLIC_XLM_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Session — HMAC-signs the session cookie so tampering is detectable.
# Generate a real value with: openssl rand -base64 32
SESSION_COOKIE_SECRET=change-me-in-production

# Keeper — bearer token the scheduler sends to POST /api/keeper/sync-loans.
# Generate a real value with: openssl rand -base64 32
CRON_SECRET=change-me-in-production

# Advance registry — our own Soroban contract (contracts/advance-registry).
# Records the borrower-signed commitment behind each cash advance.
NEXT_PUBLIC_ADVANCE_REGISTRY_ID=CC2F5JAI2REPM4CMKLSI3EMFBNHVMPOEVY7GARSCHTNHEOL536NOVWQF
